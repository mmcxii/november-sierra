{
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.4",
    "commitlint": "21.0.0",
    "eslint": "^10.3.0",
    "husky": "9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "17.0.4",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.7.3",
    "sortier": "2.1.1",
    "turbo": "^2.9.6",
    "typescript": "6.0.3",
    "vitest": "^4.1.6"
  },
  "license": "SEE LICENSE IN LICENSE",
  "name": "november-sierra",
  "packageManager": "pnpm@10.33.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "husky:commit-msg": "commitlint --edit $1",
    "husky:post-merge": "pnpm install --ignore-scripts",
    "husky:pre-commit": "lint-staged && turbo run typecheck",
    "lint": "turbo run lint",
    "prepare": "husky",
    "test": "turbo run test && vitest run --config vitest.config.ts",
    "typecheck": "turbo run typecheck"
  },
  "version": "0.0.0"
}
